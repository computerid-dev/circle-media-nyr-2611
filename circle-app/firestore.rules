rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && myRole() in ['owner', 'admin']; }

    match /users/{userId} {
      allow read: if signedIn();
      allow update: if request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow write: if isStaff();

      match /channels/{channelId} {
        allow read: if signedIn();
        allow write: if isStaff();

        match /messages/{messageId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
          allow delete: if isStaff() || resource.data.uid == request.auth.uid;
        }
      }
    }
  }
}
